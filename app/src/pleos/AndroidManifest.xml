<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The common SDK also supports cloud modes. This app enables ON_DEVICE only. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <!-- Read-only API checked against Vehicle 2.3.2 @RequiresPermission. No CONTROL_* permissions. -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <!-- Official offline Speech Service; no server registration or Internet permission. -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <queries><package android:name="ai.pleos.playground.caas" /></queries>
</manifest>
